{
  "info": {
    "name": "Raizes do Nordeste - Back-end (caminho de ouro)",
    "description": "Roteiro da demonstracao na ordem do README. Cada request encadeia variaveis (token, pedido_id, charge_id) pelos scripts de teste. Rode de cima para baixo com o stack no ar (docker compose up).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "pspUrl", "value": "http://localhost:4000" },
    { "key": "token_cliente", "value": "" },
    { "key": "token_atendente", "value": "" },
    { "key": "token_cozinheiro", "value": "" },
    { "key": "token_analista", "value": "" },
    { "key": "cliente_id_maria", "value": "" },
    { "key": "pedido_id", "value": "" },
    { "key": "charge_id", "value": "" },
    { "key": "pedido2_id", "value": "" },
    { "key": "charge2_id", "value": "" }
  ],
  "item": [
    {
      "name": "1. Login - Cliente (Maria)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "login"] },
        "body": { "mode": "raw", "raw": "{\n  \"login\": \"maria\",\n  \"senha\": \"senha123\"\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "pm.collectionVariables.set('token_cliente', j.token);",
              "pm.collectionVariables.set('cliente_id_maria', String(j.clienteId));",
              "pm.test('200 e token recebido', () => { pm.response.to.have.status(200); pm.expect(j.token).to.be.a('string'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Login - Atendente",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "login"] },
        "body": { "mode": "raw", "raw": "{\n  \"login\": \"atendente\",\n  \"senha\": \"senha123\"\n}" }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.collectionVariables.set('token_atendente', pm.response.json().token);",
          "pm.test('200', () => pm.response.to.have.status(200));"
        ] } }
      ]
    },
    {
      "name": "3. Login - Cozinheiro",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "login"] },
        "body": { "mode": "raw", "raw": "{\n  \"login\": \"cozinheiro\",\n  \"senha\": \"senha123\"\n}" }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.collectionVariables.set('token_cozinheiro', pm.response.json().token);",
          "pm.test('200', () => pm.response.to.have.status(200));"
        ] } }
      ]
    },
    {
      "name": "4. Login - Analista da Matriz",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "login"] },
        "body": { "mode": "raw", "raw": "{\n  \"login\": \"analista\",\n  \"senha\": \"senha123\"\n}" }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.collectionVariables.set('token_analista', pm.response.json().token);",
          "pm.test('200', () => pm.response.to.have.status(200));"
        ] } }
      ]
    },
    {
      "name": "5. Cardapio da unidade 1 (canal APP)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_cliente}}" }],
        "url": {
          "raw": "{{baseUrl}}/v1/unidades/1/cardapio?canal=APP",
          "host": ["{{baseUrl}}"], "path": ["v1", "unidades", "1", "cardapio"],
          "query": [{ "key": "canal", "value": "APP" }]
        }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "const j = pm.response.json();",
          "pm.test('200 e lista de itens', () => { pm.response.to.have.status(200); pm.expect(j.itens).to.be.an('array'); });",
          "pm.test('Canjica sazonal NAO aparece fora de junho/2026', () => pm.expect(j.itens.some(i => i.nome === 'Canjica Junina')).to.be.false);"
        ] } }
      ]
    },
    {
      "name": "6. Criar pedido (Cliente, canal APP)  [CT-01]",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_cliente}}" }
        ],
        "url": { "raw": "{{baseUrl}}/v1/pedidos", "host": ["{{baseUrl}}"], "path": ["v1", "pedidos"] },
        "body": { "mode": "raw", "raw": "{\n  \"unidadeId\": 1,\n  \"canal\": \"APP\",\n  \"itens\": [\n    { \"produtoId\": 1, \"quantidade\": 1 },\n    { \"produtoId\": 4, \"quantidade\": 2 }\n  ]\n}" }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "const j = pm.response.json();",
          "pm.collectionVariables.set('pedido_id', String(j.pedidoId));",
          "pm.collectionVariables.set('charge_id', j.pagamento && j.pagamento.idTransacaoPSP);",
          "pm.test('201 Created', () => pm.response.to.have.status(201));",
          "pm.test('status AGUARDANDO_PAGAMENTO', () => pm.expect(j.status).to.eql('AGUARDANDO_PAGAMENTO'));",
          "pm.test('total = 1x12 + 2x9 = 30', () => pm.expect(Number(j.total)).to.eql(30));"
        ] } }
      ]
    },
    {
      "name": "7. Consultar pedido (AGUARDANDO_PAGAMENTO)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_cliente}}" }],
        "url": { "raw": "{{baseUrl}}/v1/pedidos/{{pedido_id}}", "host": ["{{baseUrl}}"], "path": ["v1", "pedidos", "{{pedido_id}}"] }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('200', () => pm.response.to.have.status(200));",
          "pm.test('ainda nao pago', () => pm.expect(pm.response.json().status).to.eql('AGUARDANDO_PAGAMENTO'));"
        ] } }
      ]
    },
    {
      "name": "8. PSP: aprovar cobranca (dispara webhook)  [CT-04]",
      "request": {
        "method": "POST",
        "header": [],
        "url": { "raw": "{{pspUrl}}/charges/{{charge_id}}/aprovar", "host": ["{{pspUrl}}"], "path": ["charges", "{{charge_id}}", "aprovar"] }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "const j = pm.response.json();",
          "pm.test('webhook entregue com 200', () => pm.expect(j.httpStatus).to.eql(200));"
        ] } }
      ]
    },
    {
      "name": "9. Consultar pedido (agora PAGO)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_cliente}}" }],
        "url": { "raw": "{{baseUrl}}/v1/pedidos/{{pedido_id}}", "host": ["{{baseUrl}}"], "path": ["v1", "pedidos", "{{pedido_id}}"] }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('status PAGO', () => pm.expect(pm.response.json().status).to.eql('PAGO'));"
        ] } }
      ]
    },
    {
      "name": "10. Fidelidade da Maria (pontos creditados)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_cliente}}" }],
        "url": { "raw": "{{baseUrl}}/v1/clientes/{{cliente_id_maria}}/fidelidade", "host": ["{{baseUrl}}"], "path": ["v1", "clientes", "{{cliente_id_maria}}", "fidelidade"] }
