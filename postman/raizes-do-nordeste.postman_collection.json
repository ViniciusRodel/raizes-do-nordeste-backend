    {
      "name": "28. Negativo: cancelar pedido ja ENTREGUE => 409",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_atendente}}" }
        ],
        "url": { "raw": "{{baseUrl}}/v1/pedidos/{{pedido_id}}/cancelamento", "host": ["{{baseUrl}}"], "path": ["v1", "pedidos", "{{pedido_id}}", "cancelamento"] },
        "body": { "mode": "raw", "raw": "{ \"motivo\": \"Tentativa invalida - pedido ja entregue\" }" }
      },
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
