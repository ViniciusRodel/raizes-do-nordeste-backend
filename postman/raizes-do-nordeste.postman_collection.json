      "name": "12. Fidelidade da Maria (saldo NAO dobrou)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_cliente}}" }],
        "url": { "raw": "{{baseUrl}}/v1/clientes/{{cliente_id_maria}}/fidelidade", "host": ["{{baseUrl}}"], "path": ["v1", "clientes", "{{cliente_id_maria}}", "fidelidade"] }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('saldo continua 30 (idempotencia)', () => pm.expect(pm.response.json().saldo).to.eql(30));"
        ] } }
      ]
    },
    {
      "name": "13. Fila da cozinha (unidade 1)  [CT-05]",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_cozinheiro}}" }],
        "url": { "raw": "{{baseUrl}}/v1/unidades/1/fila-cozinha", "host": ["{{baseUrl}}"], "path": ["v1", "unidades", "1", "fila-cozinha"] }
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "const j = pm.response.json();",
          "pm.test('200 e o pedido esta na fila', () => { pm.response.to.have.status(200); pm.expect(j.fila.some(p => String(p.id) === pm.collectionVariables.get('pedido_id'))).to.be.true; });"
        ] } }
      ]
    },
    {
      "name": "14. Avancar status -> EM_PREPARO",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_cozinheiro}}" }
        ],
        "url": { "raw": "{{baseUrl}}/v1/pedidos/{{pedido_id}}/status", "host": ["{{baseUrl}}"], "path": ["v1", "pedidos", "{{pedido_id}}", "status"] },
        "body": { "mode": "raw", "raw": "{ \"novoStatus\": \"EM_PREPARO\" }" }
      },
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 e EM_PREPARO', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('EM_PREPARO'); });"
      ] } } ]
    },
    {
      "name": "15. Avancar status -> PRONTO",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_cozinheiro}}" }
        ],
        "url": { "raw": "{{baseUrl}}/v1/pedidos/{{pedido_id}}/status", "host": ["{{baseUrl}}"], "path": ["v1", "pedidos", "{{pedido_id}}", "status"] },
        "body": { "mode": "raw", "raw": "{ \"novoStatus\": \"PRONTO\" }" }
