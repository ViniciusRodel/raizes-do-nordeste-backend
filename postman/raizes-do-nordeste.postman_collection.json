        "header": [{ "key": "Authorization", "value": "Bearer {{token_analista}}" }],
        "url": { "raw": "{{baseUrl}}/v1/auditoria", "host": ["{{baseUrl}}"], "path": ["v1", "auditoria"] }
      },
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
        "const j = pm.response.json();",
