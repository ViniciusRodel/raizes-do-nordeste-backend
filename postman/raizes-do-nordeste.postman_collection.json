      ] } } ]
    },
    {
      "name": "17. Transicao invalida (ENTREGUE -> EM_PREPARO) => 409  [CT-20]",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_cozinheiro}}" }
        ],
        "url": { "raw": "{{baseUrl}}/v1/pedidos/{{pedido_id}}/status", "host": ["{{baseUrl}}"], "path": ["v1", "pedidos", "{{pedido_id}}", "status"] },
        "body": { "mode": "raw", "raw": "{ \"novoStatus\": \"EM_PREPARO\" }" }
      },
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
        "pm.test('codigo TRANSICAO_INVALIDA', () => pm.expect(pm.response.json().erro.codigo).to.eql('TRANSICAO_INVALIDA'));"
      ] } } ]
    },
    {
      "name": "18. RBAC: relatorio de vendas com token do Cozinheiro => 403  [CT-16]",
