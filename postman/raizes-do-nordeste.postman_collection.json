      ] } } ]
    },
    {
      "name": "21. Negativo: item sazonal fora da janela => 422  [CT-13]",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token_cliente}}" }
        ],
        "url": { "raw": "{{baseUrl}}/v1/pedidos", "host": ["{{baseUrl}}"], "path": ["v1", "pedidos"] },
        "body": { "mode": "raw", "raw": "{\n  \"unidadeId\": 1,\n  \"canal\": \"APP\",\n  \"itens\": [ { \"produtoId\": 5, \"quantidade\": 1 } ]\n}" }
      },
      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('422 Unprocessable', () => pm.response.to.have.status(422));",
        "pm.test('motivo FORA_DA_JANELA_SAZONAL', () => pm.expect(JSON.stringify(pm.response.json())).to.include('FORA_DA_JANELA_SAZONAL'));"
      ] } } ]
