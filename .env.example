# Copie para .env ao rodar fora do Docker (docker-compose ja injeta estes valores)
PORT=3000
DATABASE_URL=postgres://raizes:raizes@localhost:5432/raizes
JWT_SECRET=dev-jwt-secret-troque-em-producao
JWT_EXPIRA_EM=8h
PSP_BASE_URL=http://localhost:4000
PSP_WEBHOOK_SECRET=dev-psp-hmac-secret
WEBHOOK_URL_PUBLICA=http://localhost:3000/v1/webhooks/pagamento
SEED_ON_BOOT=false
# Chave do pgcrypto para cifrar dados pessoais do cliente (RNF-06).
# Em producao vem de um KMS/cofre, nunca de uma variavel de ambiente estatica.
DADOS_PESSOAIS_CHAVE=dev-chave-dados-pessoais-troque-em-producao
